		"description": "Production-ready Postman collection for EasyLease Tax Filling. Configured for high-reliability invoice clearance and reporting in the Live environment.\n\n### Authentication\n- **HMAC Signature**: Automatically generated for all ERP endpoints.\n- **Admin Access**: Uses production credentials from the 'EasyLease - Live' environment.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "0. Health & Authentication",
			"item": [
				{
					"name": "Production Login",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"{{adminEmail}}\",\n    \"password\": \"{{adminPassword}}\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "login"]
						}
					}
				},
				{
					"name": "ZATCA Production Ping",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/zatca/ping/production",
							"host": ["{{baseUrl}}"],
							"path": ["api", "zatca", "ping", "production"]
						}
					}
