		{
			"name": "2. Live Webhooks",
			"item": [
				{
					"name": "Update Webhook URL",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "x-api-key", "value": "{{apiKey}}" },
							{ "key": "x-timestamp", "value": "{{currentTimestamp}}" },
							{ "key": "x-nonce", "value": "{{currentNonce}}" },
							{ "key": "x-signature", "value": "{{calculatedSignature}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"url\": \"https://api.yourdomain.com/zatca/webhook\",\n    \"events\": [\"INVOICE_CLEARED\", \"INVOICE_REPORTED\", \"INVOICE_REJECTED\"]\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/erp/webhooks",
							"host": ["{{baseUrl}}"],
