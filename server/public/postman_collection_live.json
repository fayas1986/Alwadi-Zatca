		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"exec": [
					"const now = new Date();",
					"const timestamp = now.toISOString();",
					"const nonce = CryptoJS.lib.WordArray.random(16).toString();",
					"pm.collectionVariables.set('currentTimestamp', timestamp);",
					"pm.collectionVariables.set('currentNonce', nonce);",
					"",
					"// ZATCA compliant date/time",
					"const year = now.getFullYear();",
					"const month = String(now.getMonth() + 1).padStart(2, '0');",
					"const day = String(now.getDate()).padStart(2, '0');",
					"const hours = String(now.getHours()).padStart(2, '0');",
					"const minutes = String(now.getMinutes()).padStart(2, '0');",
					"const seconds = String(now.getSeconds()).padStart(2, '0');",
					"pm.collectionVariables.set('currentDate', `${year}-${month}-${day}`);",
					"pm.collectionVariables.set('currentTime', `${hours}:${minutes}:${seconds}`);",
					"",
					"const method = pm.request.method.toUpperCase();",
					"const path = pm.request.url.getPathWithQuery();",
					"const apiKey = pm.collectionVariables.get('apiKey');",
					"",
					"function stableStringify(obj) {",
					"    if (obj === null || typeof obj !== 'object') return JSON.stringify(obj);",
					"    if (Array.isArray(obj)) return '[' + obj.map(stableStringify).join(',') + ']';",
					"    const keys = Object.keys(obj).sort();",
					"    return '{' + keys.map(k => '\"' + k + '\":' + stableStringify(obj[k])).join(',') + '}';",
					"}",
					"",
					"let bodyHash = '';",
					"if (method !== 'GET' && pm.request.body && pm.request.body.raw) {",
					"    try {",
					"        const body = JSON.parse(pm.request.body.raw);",
					"        bodyHash = CryptoJS.SHA256(stableStringify(body)).toString();",
					"    } catch(e) { bodyHash = ''; }",
					"}",
					"",
					"const dataToSign = timestamp + nonce + method + path + bodyHash;",
					"const signature = CryptoJS.HmacSHA256(dataToSign, apiKey).toString();",
					"pm.collectionVariables.set('calculatedSignature', signature);"
				],
				"type": "text/javascript"
			}
		},
		{
			"listen": "test",
			"script": {
				"exec": [
					"if (pm.response.code === 202 || pm.response.code === 200) {",
					"    const jsonData = pm.response.json();",
					"    if (jsonData.data && jsonData.data.jobId) {",
					"        pm.collectionVariables.set('lastJobId', jsonData.data.jobId);",
					"    } else if (jsonData.jobId) {",
					"        pm.collectionVariables.set('lastJobId', jsonData.jobId);",
					"    }",
					"}"
				],
				"type": "text/javascript"
			}
		}
	],
	"variable": [
		{ "key": "baseUrl", "value": "https://easylease.sakytek.com" },
		{ "key": "apiKey", "value": "sk_live_zatcaconnect_prod_v1" },
		{ "key": "adminEmail", "value": "kamila.banu@easylease.ae" },
		{ "key": "adminPassword", "value": "password123" },
		{ "key": "lastJobId", "value": "" }
	]
}
