# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/alwadi_zatca?sslmode=require"

# System Paths & Execution
ZATCA_SDK_PATH="./server/zatca-sdk/zatca-sdk.jar"
JAVA_EXE_PATH="java"
PORT=3001
NODE_ENV="development"
USE_MOCK_SDK="false"

# Customer Branding & Configuration
COMPANY_REGISTERED_NAME="Alwadi Trading L.L.C."
ALLOWED_USER_DOMAINS="alwadi.sa,alwadi.com,system.local"

# ERP Integration (Dynamics 365 F&O / Custom ERP)
D365_CLIENT_ID="00000000-0000-0000-0000-000000000000"
D365_CLIENT_SECRET="your_d365_client_secret_here"
D365_TENANT_ID="00000000-0000-0000-0000-000000000000"
D365_BASE_URL="https://your-instance.operations.dynamics.com/"

# ZATCA Connector API Key (Push Integration)
ZATCA_API_KEY="sk_test_alwadi_connector_v1"
