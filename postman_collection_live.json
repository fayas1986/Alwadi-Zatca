  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "// Generate single-evaluation static variables to avoid double-evaluation mismatches",
          "if (pm.request.body && pm.request.body.raw) {",
          "    const bodyStr = pm.request.body.raw;",
          "    if (bodyStr.indexOf('webhookGuid') !== -1) {",
          "        pm.collectionVariables.set('webhookGuid', CryptoJS.lib.WordArray.random(16).toString());",
          "    }",
          "    if (bodyStr.indexOf('invoiceUuid') !== -1) {",
          "        pm.collectionVariables.set('invoiceUuid', CryptoJS.lib.WordArray.random(16).toString());",
          "    }",
          "    if (bodyStr.indexOf('invoiceRandomInt') !== -1) {",
          "        pm.collectionVariables.set('invoiceRandomInt', Math.floor(Math.random() * 1000000).toString());",
          "    }",
          "}",
          "",
          "const timestamp = new Date().toISOString();",
          "const nonce = CryptoJS.lib.WordArray.random(16).toString();",
          "pm.collectionVariables.set('currentTimestamp', timestamp);",
          "pm.collectionVariables.set('currentNonce', nonce);",
          "",
          "const method = pm.request.method.toUpperCase();",
          "const path = pm.variables.replaceIn(pm.request.url.getPathWithQuery());",
          "const secretRaw = pm.environment.get('apiKey') || pm.collectionVariables.get('clientSecret') || pm.variables.get('apiKey') || \"\";",
          "const secret = secretRaw.trim();",
          "",
          "function stableStringify(obj) {",
          "    if (obj === null || typeof obj !== 'object') return JSON.stringify(obj);",
          "    if (Array.isArray(obj)) return '[' + obj.map(stableStringify).join(',') + ']';",
          "    const keys = Object.keys(obj).sort();",
          "    return '{' + keys.map(k => '\"' + k + '\":' + stableStringify(obj[k])).join(',') + '}';",
          "}",
          "",
          "let bodyHash = '';",
          "if (method !== 'GET' && pm.request.body.raw) {",
          "    try {",
          "        const body = JSON.parse(pm.variables.replaceIn(pm.request.body.raw));",
          "        bodyHash = CryptoJS.SHA256(stableStringify(body)).toString();",
          "    } catch(e) { bodyHash = ''; }",
          "}",
          "",
          "const dataToSign = timestamp + nonce + method + path + bodyHash;",
          "const signature = CryptoJS.HmacSHA256(dataToSign, secret).toString();",
          "pm.collectionVariables.set('calculatedSignature', signature);"
        ],
        "type": "text/javascript"
      }
    },
    {
      "listen": "test",
      "script": {
        "exec": [
          "if (pm.response.code === 202 || pm.response.code === 200) {",
          "    const jsonData = pm.response.json();",
          "    if (jsonData.data && jsonData.data.jobId) {",
          "        pm.collectionVariables.set('lastJobId', jsonData.data.jobId);",
          "    } else if (jsonData.jobId) {",
          "        pm.collectionVariables.set('lastJobId', jsonData.jobId);",
          "    }",
          "}"
        ],
        "type": "text/javascript"
      }
    }
  ],
